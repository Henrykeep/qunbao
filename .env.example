# —— 网页登录（必填）——
WEB_USER=me
WEB_PASS=换成一个长密码

# —— 大模型（任意 OpenAI 兼容接口，例：DeepSeek / 通义 / Kimi / OpenAI）——
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# —— 以下几项只是第一次启动的默认值，之后都在网页「设置」里改 ——
MY_PROFILE=我是大三学生，在 XX 班；关心作业截止、考试、开会、缴费、需要我回复或报名的事
DIGEST_HOUR=21
BARK_URL=
SITE_URL=

# —— NapCat HTTP 服务（用来查群名，可选）——
NAPCAT_HTTP=http://napcat:3000
NAPCAT_TOKEN=

# —— 以后接微信（旧安卓机转发通知）用的口令 ——
INGEST_TOKEN=换成随机字符串

# —— 原始消息保留天数 ——
KEEP_DAYS=30
# 网页登录保持天数（常用会自动续期）
SESSION_DAYS=30
# 时区（时间解析、免打扰、每日整理都按它；默认 Asia/Shanghai）
# APP_TZ=Asia/Shanghai
